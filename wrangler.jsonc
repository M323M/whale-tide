{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whale-tide",
  "main": "_worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
