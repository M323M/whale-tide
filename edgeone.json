{
  "buildCommand": "node scripts/build-edgeone.mjs",
  "outputDirectory": "edgeone/dist",
  "cache-control": {
    "/": "no-store",
    "/*.html": "no-store",
    "/assets/js/*": "public, max-age=0, must-revalidate",
    "/assets/css/*": "public, max-age=0, must-revalidate",
    "/assets/vendor/*": "public, max-age=0, must-revalidate",
    "/assets/img/*": "public, max-age=604800"
  }
}
